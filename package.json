{
  "name": "halias",
  "license": "GPL-3.0-only",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "halias": "node packages/sdk/dist/cli.js",
    "check": "npm run typecheck --workspaces --if-present && npm run lint",
    "test": "npm run test --workspaces --if-present",
    "lint": "solhint \"packages/protocol/contracts/**/*.sol\" && eslint packages/sdk/src packages/protocol/scripts packages/protocol/test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "solhint": "^6.2.3",
    "typescript-eslint": "^8.67.0"
  }
}
