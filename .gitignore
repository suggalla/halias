# dependencies
node_modules/

# build output
dist/

# hardhat
cache/
artifacts/
typechain-types/

# circuit artifacts (compiled output + ceremony)
circuits/out/

# sveltekit
.svelte-kit/
/packages/app/build/

# Deployment records. NOT ignored wholesale: these are contract addresses on public
# chains, and `deployments/` unanchored swallowed the entire halias-deployments workspace
# package — source, package.json and all — which the SDK depends on, so a fresh clone could
# not even install. Only the file the local node rewrites on every deploy is ignored.
packages/deployments/networks/localhost.json

# environment
.env
.env.*
!.env.example

# ceremony files (large binaries)
*.ptau
*.zkey
*.wtns

# circuit build intermediates (regenerated by circom; not needed at runtime/on-chain)
*.sym
*.r1cs

# Anchor anything whose name is plausible as a source directory. An unanchored rule matches
# at every depth, and this file has twice hidden real source that way — packages/app/src/lib
# (SvelteKit's own convention) and the halias-deployments package.
# Before adding a rule here, check `git status --ignored` for what it caught.

# workspace
packages/*/node_modules/

# OS
.DS_Store
Thumbs.db

# Build + coverage output
coverage/
coverage.json
*.tsbuildinfo

# Foundry (fuzz + invariant tests). Restore with: forge install foundry-rs/forge-std --no-git
# Anchored to the repo root. Unanchored, `lib/` and `out/` match at every depth — which
# silently swallowed packages/protocol/circuits/lib/notes.circom, a source file the circuit
# does not compile without. circuits/out is still ignored, explicitly, below.
/lib/
/cache_forge/
/out/

# Proof artifacts are copied from packages/protocol at build time
static/artifacts/
