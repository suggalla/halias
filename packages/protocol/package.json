{
  "name": "halias-protocol",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "ceremony": "tsc && node dist/setup-ceremony.js",
    "export-verifier": "tsc && node dist/export-verifier.js",
    "compile": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat compile",
    "test:hardhat": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat test",
    "circuits:compile": "mkdir -p circuits/out/transact && $HOME/.cargo/bin/circom circuits/transact.circom --r1cs --wasm --sym -o circuits/out/transact -l ../../node_modules/circomlib/circuits",
    "circuits:setup": "npm run ceremony -- -c transact -p 17 --dev && npm run export-verifier -- -c transact",
    "circuits:build": "npm run circuits:compile && npm run circuits:setup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^25.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "hardhat": "^2.28.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "poseidon-solidity": "^0.0.5",
    "snarkjs": "^0.7.6",
    "tweetnacl": "^1.0.3"
  }
}
