{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "0.8.28"
    ],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "max-line-length": [
      "error",
      120
    ],
    "no-unused-vars": "error",
    "state-visibility": "error",
    "avoid-tx-origin": "error",
    "check-send-result": "error",
    "multiple-sends": "error",
    "no-complex-fallback": "error",
    "no-empty-blocks": "error",
    "gas-custom-errors": "error",
    "avoid-low-level-calls": "error",
    "reentrancy": "error",
    "no-inline-assembly": "off",
    "not-rely-on-time": "off",
    "reason-string": "off",
    "one-contract-per-file": "off",
    "no-global-import": "warn",
    "ordering": "warn",
    "use-natspec": "off",
    "gas-increment-by-one": "warn",
    "gas-strict-inequalities": "warn",
    "gas-struct-packing": "warn",
    "gas-indexed-events": "warn",
    "gas-small-strings": "off",
    "gas-length-in-loops": "warn",
    "gas-multitoken1155": "off",
    "func-named-parameters": "warn",
    "immutable-vars-naming": "warn",
    "var-name-mixedcase": "off",
    "foundry-test-functions": "off",
    "explicit-types": "warn",
    "no-unused-import": "error",
    "private-vars-leading-underscore": "off"
  }
}
