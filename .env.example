# Halias — copy to .env at the repo root. This is the ONLY .env the repo reads;
# hardhat, the SDK CLI and the app all resolve to it.

# Deployer key. Testnet only unless you know what you are doing.
PRIVATE_KEY=0x...

# JSON-RPC endpoint for the target chain.
RPC_URL=https://...

# Chain id, used by the SDK CLI (11155111 = Sepolia).
CHAIN_ID=11155111

# Etherscan V2 key — one key covers all supported chains.
# Needed for `npx hardhat verify`; leave blank to skip verification.
ETHERSCAN_API_KEY=
